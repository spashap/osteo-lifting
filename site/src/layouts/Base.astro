---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/cormorant-garamond/wght.css';
import '../styles/global.css';

import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCta from '../components/MobileCta.astro';
import { GA4_ID } from '../config';
import { LANG_TAG, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Locale-relative path, e.g. "courses/osteo-body". Empty for the home page. */
  subpath?: string;
  /** Ready-made JSON-LD string (see lib/schema.ts). */
  schema?: string;
  telegram?: string;
  whatsapp?: string;
}

const {
  locale,
  title,
  description,
  subpath = '',
  schema,
  telegram,
  whatsapp,
} = Astro.props;

const t = useTranslations(locale);
---

<!doctype html>
<html lang={LANG_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#211b18" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo locale={locale} title={title} description={description} subpath={subpath} />
    {/*
      Runs before first paint so revealed blocks never flash in at their final
      position. If this does not run — no JavaScript, reduced motion, an ancient
      engine — `.motion` is absent and everything simply renders as-is.
    */}
    <script is:inline>
      if (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        'IntersectionObserver' in window
      ) {
        document.documentElement.classList.add('motion');
      }
    </script>
    {schema && <script type="application/ld+json" is:inline set:html={schema} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.ui.skipToContent}</a>
    <Header locale={locale} subpath={subpath} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} subpath={subpath} />
    <MobileCta locale={locale} telegram={telegram} whatsapp={whatsapp} />

    {/*
      The only motion JavaScript on the site — inline, no network request.
      Reveals blocks as they scroll in (with a stagger inside each group) and
      counts the credibility numbers up. Everything else is CSS.
    */}
    <script is:inline>
      (() => {
        if (!document.documentElement.classList.contains('motion')) return;

        const targets = [...document.querySelectorAll('.reveal, .section-head')];

        /* Stagger siblings so grids and lists arrive in sequence rather than
           all at once. Capped so long lists do not crawl. */
        const seen = new Map();
        for (const el of targets) {
          const parent = el.parentElement;
          const index = seen.get(parent) ?? 0;
          seen.set(parent, index + 1);
          if (index) {
            el.style.setProperty('--reveal-delay', `${Math.min(index, 8) * 75}ms`);
          }
        }

        const reveal = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-in');
              reveal.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -10%' },
        );

        for (const el of targets) reveal.observe(el);

        const numbers = document.querySelectorAll('[data-count-to]');
        if (!numbers.length) return;

        const count = (el) => {
          const target = Number(el.dataset.countTo);
          const duration = 1400;
          let started;
          const tick = (now) => {
            started ??= now;
            const p = Math.min((now - started) / duration, 1);
            el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 4))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };

        const counter = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              counter.unobserve(entry.target);
              count(entry.target);
            }
          },
          { threshold: 0.4 },
        );

        for (const el of numbers) {
          el.textContent = '0';
          counter.observe(el);
        }
      })();
    </script>

    {
      GA4_ID && (
        <script is:inline>
          document.addEventListener('click', (event) => {
            const link = event.target instanceof Element && event.target.closest('a[href]');
            if (!link || typeof window.gtag !== 'function') return;
            const href = link.getAttribute('href') || '';
            if (!/^https?:/i.test(href) || href.includes(location.host)) return;
            let channel = 'other';
            if (href.includes('t.me')) channel = 'telegram';
            else if (href.includes('whatsapp')) channel = 'whatsapp';
            else if (href.includes('facebook')) channel = 'facebook';
            window.gtag('event', 'outbound_click', {
              channel,
              link_url: href,
              link_text: (link.textContent || '').trim().slice(0, 80),
              page_path: location.pathname,
              page_language: document.documentElement.lang,
            });
          });
        </script>
      )
    }
  </body>
</html>

<style is:global>
  body { padding-bottom: 4.5rem; }

  @media (min-width: 62em) {
    body { padding-bottom: 0; }
  }
</style>
