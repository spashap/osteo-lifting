---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CourseGrid from '../../../components/CourseGrid.astro';
import CtaBand from '../../../components/CtaBand.astro';

import { LOCALES, localePath, useTranslations, type Locale } from '../../../i18n';
import { graph, organization, courseList, course, breadcrumbs } from '../../../lib/schema';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const trail = [
  { name: t.ui.breadcrumbHome, path: localePath(lang) },
  { name: t.coursesSection.titlePlain, path: localePath(lang, 'courses') },
];

const schema = graph([
  organization(lang),
  courseList(lang),
  ...t.courses.map((item) => course(lang, item.slug)),
  breadcrumbs(lang, trail),
]);
---

<Base
  locale={lang}
  title={t.seo.coursesTitle}
  description={t.seo.coursesDescription}
  subpath="courses"
  schema={schema}
>
  <Breadcrumbs trail={trail} />
  <PageHero eyebrow={t.brand.mark} titleBrand={t.coursesSection.titlePlain} />
  <CourseGrid locale={lang} showEyebrow={false} heading={t.nav.courses} />
  <CtaBand locale={lang} />
</Base>
