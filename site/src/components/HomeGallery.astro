---
import { Picture } from 'astro:assets';
import { img } from '../data/images';
import { localePath, useTranslations, type Locale } from '../i18n';

/**
 * Six photographs from the history page, surfaced on the home page. Graduates
 * with certificates and rooms full of people practising are the most immediately
 * legible proof that this is a real school — and this is also the only route to
 * `/history/` between the hero and the footer.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const keys = ['academy-15', 'academy-16', 'academy-17', 'academy-19', 'academy-13', 'academy-05'];
---

<section class="section section--dark gallery">
  <div class="container">
    <div class="section-head gallery__head">
      <div>
        <p class="eyebrow">{t.nav.history}</p>
        <h2 class="h2">{t.ui.galleryTitle}</h2>
        <hr class="rule" />
      </div>
      <a class="btn btn--ghostOnDark gallery__cta" href={localePath(locale, 'history')}>
        {t.hero.ctaHistory}
      </a>
    </div>

    <ul class="gallery__strip">
      {
        keys.map((key) => (
          <li class="gallery__item reveal">
            <a class="gallery__link" href={localePath(locale, 'history')}>
              <figure class="figure gallery__figure">
                <Picture
                  src={img(key)}
                  formats={['avif', 'webp']}
                  widths={[280, 420, 620]}
                  sizes="(min-width: 62em) 17vw, 62vw"
                  alt={t.alt[key as keyof typeof t.alt]}
                  loading="lazy"
                />
              </figure>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .gallery__head .rule { margin-top: 0.75rem; }

  /* Swipeable on small screens, an even row on large ones. */
  .gallery__strip {
    list-style: none;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62%;
    gap: 0.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
  }

  .gallery__strip::-webkit-scrollbar { display: none; }

  .gallery__item { scroll-snap-align: start; }

  .gallery__link {
    display: block;
    border-radius: var(--radius-lg);
  }

  .gallery__figure {
    margin: 0;
    aspect-ratio: 3 / 4;
    transition: box-shadow 250ms ease;
  }

  .gallery__link:hover .gallery__figure { box-shadow: var(--shadow); }

  @media (min-width: 48em) {
    .gallery__strip { grid-auto-columns: 32%; }
  }

  @media (min-width: 62em) {
    .gallery__head {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }

    .gallery__strip {
      grid-auto-flow: row;
      grid-template-columns: repeat(6, 1fr);
      grid-auto-columns: auto;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      padding-bottom: 0;
    }
  }
</style>
