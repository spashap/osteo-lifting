---
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Renders the mark only, without the OSTEO-LIFTING lockup line. */
  compact?: boolean;
}

const { locale, compact = false } = Astro.props;
const t = useTranslations(locale);
---

<a class="wordmark" href={localePath(locale)} aria-label={t.brand.name}>
  <svg class="wordmark__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <path
      d="M3.5 29.5V14a12.5 12.5 0 0 1 25 0v15.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
    ></path>
    <path
      d="M11.5 29.5V14.5a4.5 4.5 0 0 1 9 0v15"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      opacity="0.45"></path>
  </svg>
  <span class="wordmark__text">
    <span class="wordmark__mao">{t.brand.mark}</span>
    {!compact && <span class="wordmark__sub">{t.brand.wordmark}</span>}
  </span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: inherit;
  }

  .wordmark__mark {
    width: 1.75rem;
    height: 1.75rem;
    flex: none;
    color: var(--accent);
  }

  .wordmark__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .wordmark__mao {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .wordmark__sub {
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  :global(.site-footer) .wordmark__sub {
    color: var(--on-contrast-soft);
  }
</style>
