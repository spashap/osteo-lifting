---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="stats" aria-label={t.founder.nameNatural}>
  <div class="container stats__inner">
    {
      t.founder.stats.map((stat) => (
        <div class="stats__item reveal">
          <p class="stats__prefix">{stat.prefix}</p>
          <p class="stats__value">
            <span
              class="stats__num"
              data-count-to={stat.value}
              style={`--digits:${stat.value.length}`}>{stat.value}</span>
          </p>
          <p class="stats__label">{stat.label}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats {
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }

  .stats__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto auto;
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }

  .stats__item {
    display: grid;
    grid-row: span 3;
    grid-template-rows: subgrid;
    gap: 0.15rem;
    position: relative;
  }

  /* Without subgrid, reserve two lines for the prefix so the numbers still
     line up when one prefix wraps and another does not. */
  @supports not (grid-template-rows: subgrid) {
    .stats__item { display: flex; flex-direction: column; }
    .stats__prefix { min-height: 2.4em; }
  }

  .stats__item + .stats__item::before {
    content: '';
    position: absolute;
    left: calc(-1 * clamp(0.5rem, 1.5vw, 1.25rem));
    top: 15%;
    bottom: 15%;
    width: 1px;
    background: var(--line);
  }

  .stats__prefix {
    align-self: end;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 500;
    line-height: 1;
    color: var(--contrast);
    /* tabular so the digits do not jitter while the counter runs */
    font-variant-numeric: lining-nums tabular-nums;
    font-feature-settings: 'lnum' 1, 'tnum' 1;
  }

  /* Reserve the final width so the counter cannot shift the layout as it runs. */
  .stats__num {
    display: inline-block;
    min-width: calc(var(--digits) * 1ch);
  }

  .stats__label {
    align-self: start;
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-wrap: balance;
  }
</style>
