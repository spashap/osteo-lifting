---
import { Picture } from 'astro:assets';
import { img } from '../data/images';
import { SOCIAL, TELEGRAM, WHATSAPP } from '../config';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const links = [
  { label: 'Telegram', href: TELEGRAM.ariel },
  { label: 'WhatsApp', href: WHATSAPP.ariel },
  { label: 'Instagram', href: SOCIAL.arielInstagram },
  { label: 'Facebook', href: SOCIAL.arielFacebook },
];
---

<section class="section" id="instructors">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.nav.instructors}</p>
      <hr class="rule" />
    </div>

    <article class="person reveal">
      <figure class="person__figure figure ratio-square">
        <Picture
          src={img('ariel-pelevin')}
          formats={['avif', 'webp']}
          widths={[360, 560, 760]}
          sizes="(min-width: 62em) 34vw, 88vw"
          alt={t.alt['ariel-pelevin']}
          loading="lazy"
        />
      </figure>

      <div class="person__body">
        <p class="person__eyebrow">{t.founder.eyebrow}</p>
        <p class="person__prefix">{t.founder.prefix}</p>
        <h3 class="person__name h2">{t.founder.name}</h3>
        <ul class="person__bullets">
          {t.founder.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        <ul class="person__links">
          {
            links.map((link) => (
              <li>
                <a href={link.href} target="_blank" rel="noopener">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </div>
</section>

<style>
  .person {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
  }

  .person__figure {
    margin: 0;
    max-width: 24rem;
  }

  .person__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .person__eyebrow {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .person__prefix {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .person__name { margin-top: 0.15rem; }

  .person__bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 0.9rem;
    color: var(--ink-soft);
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: 48ch;
  }

  .person__bullets li {
    position: relative;
    padding-left: 1.2rem;
  }

  .person__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.6rem;
    height: 1px;
    background: var(--accent);
  }

  .person__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1.4rem;
  }

  .person__links a {
    display: inline-flex;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ink-soft);
    transition: border-color 160ms ease, color 160ms ease;
  }

  .person__links a:hover {
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  @media (min-width: 48em) {
    .person { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); }
    .person__figure { max-width: none; }
  }
</style>
