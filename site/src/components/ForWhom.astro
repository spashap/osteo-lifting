---
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section section--tint" id="for-whom">
  <div class="container">
    <div class="section-head">
      <h2 class="h2">{t.forWhom.title}</h2>
      <hr class="rule" />
    </div>

    <ul class="audience">
      {
        t.forWhom.items.map((item) => (
          <li class="audience__item reveal">
            <img
              class="audience__icon"
              src={`/icons/icon-${item.icon}.svg`}
              width="48"
              height="48"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <p class="audience__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .audience {
    list-style: none;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .audience__item {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .audience__icon {
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
  }

  .audience__text {
    font-size: var(--step-0);
    line-height: 1.4;
    color: var(--ink);
  }

  @media (min-width: 48em) {
    .audience { grid-template-columns: repeat(3, 1fr); }
    .audience__item { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
    .audience__text { font-size: var(--step-1); }
  }
</style>
