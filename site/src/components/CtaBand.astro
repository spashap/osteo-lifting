---
import { PHONE, TELEGRAM } from '../config';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/** Both booking links exactly as the Osteo-lifting product block words them. */
const ctas = t.courses[0].ctas;
---

<section class="cta section--dark">
  <div class="container cta__inner">
    <div class="cta__text">
      <p class="eyebrow">{t.brand.mark}</p>
      <p class="cta__lede">
        {t.history.contactLine} <span class="cta__hi">{t.history.contactCta}</span>
      </p>
      <a class="cta__phone" href={`tel:${PHONE}`}>{PHONE}</a>
    </div>
    <div class="cta__actions">
      {
        ctas.map((cta, i) => (
          <a
            class:list={['btn', i === 0 ? 'btn--onDark' : 'btn--ghostOnDark']}
            href={cta.href}
            target="_blank"
            rel="noopener"
          >
            {cta.label}
          </a>
        ))
      }
      <a class="btn btn--ghostOnDark" href={TELEGRAM.ariel} target="_blank" rel="noopener">
        {t.ui.consultation}
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--contrast);
    color: var(--on-contrast);
    padding-block: var(--section-y);
  }

  .cta__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  .cta__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .cta__lede {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.2;
    max-width: 24ch;
  }

  .cta__hi { color: var(--accent); }

  .cta__phone {
    font-family: var(--font-display);
    font-size: var(--step-3);
    letter-spacing: 0.02em;
    font-variant-numeric: lining-nums;
    font-feature-settings: 'lnum' 1;
    text-decoration: none;
    color: var(--on-contrast);
    border-bottom: 1px solid rgba(244, 239, 233, 0.3);
  }

  .cta__phone:hover { border-color: var(--accent); color: var(--accent); }

  .cta__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
  }

  @media (min-width: 48em) {
    .cta__actions { align-items: flex-start; }
    .cta__actions .btn { width: auto; }
  }

  @media (min-width: 62em) {
    .cta__inner { grid-template-columns: 1.2fr 0.8fr; }
  }
</style>
