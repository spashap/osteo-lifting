---
import { useTranslations, type Locale } from '../i18n';

/**
 * Outbound link to the Osteo-lifting reel. Restored at the client's request
 * after the Instagram sweep — it is the one Instagram reference he wants kept.
 *
 * Deliberately a plain link, not an embed: Instagram's embed script is heavy
 * third-party JavaScript and would undo the site's zero-bundle budget.
 */
interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const items = t.videos?.items ?? [];
---

{
  items.length > 0 && (
    <section class="videos-section section--tint">
      <div class="container">
        <ul class="videos">
          {items.map((video) => (
            <li class="videos__item reveal">
              <a class="videos__link" href={video.href} target="_blank" rel="noopener">
                <span class="videos__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20">
                    <path d="M8 5.5v13l10-6.5-10-6.5Z" fill="currentColor" />
                  </svg>
                </span>
                <span class="videos__label">{video.label}</span>
                <span class="videos__host">Instagram</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .videos-section { padding-block: clamp(2.5rem, 5vw, 4rem); }

  .videos {
    list-style: none;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .videos__link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: clamp(1.1rem, 2.5vw, 1.5rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .videos__link:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .videos__play {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: 999px;
    background: var(--contrast);
    color: var(--on-contrast);
  }

  .videos__label {
    flex: 1;
    font-family: var(--font-display);
    font-size: var(--step-1);
  }

  .videos__host {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* One card should not stretch the full width of a 1200px container. */
  @media (min-width: 48em) {
    .videos { grid-template-columns: repeat(auto-fit, minmax(0, 28rem)); }
  }
</style>
