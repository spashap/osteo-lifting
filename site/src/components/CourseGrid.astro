---
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** Slug to leave out — used on a course page to show "the other four". */
  exclude?: string;
  heading?: string;
  tint?: boolean;
  showEyebrow?: boolean;
}

const { locale, exclude, heading, tint = false, showEyebrow = true } = Astro.props;
const t = useTranslations(locale);
const courses = t.courses.filter((course) => course.slug !== exclude);
---

<section class:list={['section', tint && 'section--tint']} id="courses">
  <div class="container">
    <div class="section-head">
      {showEyebrow && <p class="eyebrow">{t.nav.courses}</p>}
      <h2 class="h2">{heading ?? t.coursesSection.titlePlain}</h2>
      <hr class="rule" />
    </div>

    <ul class="courses">
      {
        courses.map((course, i) => (
          <li class="course reveal">
            <a class="course__link" href={localePath(locale, `courses/${course.slug}`)}>
              <span class="course__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="course__title h3">{course.title}</h3>
              <p class="course__meta">
                {course.format} {course.teachers[0]}
              </p>
              <p class="course__summary">{course.summary}</p>
              <span class="course__more">{t.ui.more}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .courses {
    list-style: none;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .course { display: flex; }

  .course__link {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    width: 100%;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: border-color 200ms ease, transform 200ms ease, box-shadow 200ms ease;
  }

  .course__link:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .course__num {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  .course__title { margin-top: 0.1rem; }

  .course__meta {
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .course__summary {
    margin-top: 0.35rem;
    font-size: var(--step--1);
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .course__more {
    margin-top: auto;
    padding-top: 1.1rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .course__link:hover .course__more { text-decoration: underline; }

  @media (min-width: 48em) {
    .courses { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 76em) {
    .courses { grid-template-columns: repeat(3, 1fr); }
  }
</style>
