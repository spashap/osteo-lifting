---
import { Picture } from 'astro:assets';
import { img } from '../data/images';
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const sculpture = img('hero-sculpture');
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="eyebrow">{t.brand.mark}</p>
      <h1 class="hero__title">
        <span class="hero__titleTop">{t.hero.titleTop}</span>
        <span class="hero__titleBrand">{t.hero.titleBrand}</span>
      </h1>
      <div class="hero__actions">
        <a class="btn btn--onDark" href={localePath(locale, 'method')}>{t.hero.ctaMethod}</a>
        <a class="btn btn--ghostOnDark" href={localePath(locale, 'history')}>
          {t.hero.ctaHistory}
        </a>
      </div>
    </div>

    <figure class="hero__figure figure">
      {/*
        The photograph is the only thing that loads with the page — it is the
        hero's largest paint and must not wait on anything. The clip is fetched
        only after `load`, during idle time, and cross-fades in on top once it
        is genuinely playing.
      */}
      <Picture
        src={sculpture}
        formats={['avif', 'webp']}
        widths={[420, 640, 880]}
        sizes="(min-width: 62em) 34vw, 76vw"
        alt={t.alt['hero-sculpture']}
        loading="eager"
        fetchpriority="high"
      />

      <video
        class="hero__video"
        data-hero-video
        width="464"
        height="640"
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="none"
        aria-hidden="true"
        tabindex="-1"><source
          src="/media/hero-sculpture.av1.mp4"
          type="video/mp4; codecs=av01.0.05M.08"
        /><source src="/media/hero-sculpture.h264.mp4" type="video/mp4; codecs=avc1.4D401F" /></video>
    </figure>
  </div>
</section>

<script is:inline>
  (() => {
    const video = document.querySelector('[data-hero-video]');
    if (!video) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    /* Never spend someone's metered or slow connection on decoration. */
    const net = navigator.connection;
    if (net && (net.saveData || /(^|-)2g$/.test(net.effectiveType || ''))) return;

    const start = () => {
      video.addEventListener('playing', () => video.classList.add('is-playing'), {
        once: true,
      });
      video.load();
      const attempt = video.play();
      if (attempt) attempt.catch(() => {});

      /* Stop decoding once it is scrolled away. */
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                const resumed = video.play();
                if (resumed) resumed.catch(() => {});
              } else {
                video.pause();
              }
            }
          },
          { threshold: 0.05 },
        ).observe(video);
      }
    };

    const idle = (fn) =>
      'requestIdleCallback' in window
        ? requestIdleCallback(fn, { timeout: 2500 })
        : setTimeout(fn, 400);

    if (document.readyState === 'complete') idle(start);
    else window.addEventListener('load', () => idle(start), { once: true });
  })();
</script>

<style>
  .hero {
    position: relative;
    background: var(--contrast);
    color: var(--on-contrast);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      120% 90% at 78% 15%,
      rgba(176, 141, 122, 0.28),
      transparent 62%
    );
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 9vw, 6.5rem);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: flex-start;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    gap: 0.15em;
    margin: 0;
  }

  .hero__titleTop {
    font-size: var(--step-3);
    font-weight: 300;
    font-style: italic;
    color: var(--on-contrast-soft);
    letter-spacing: 0;
  }

  .hero__titleBrand {
    font-size: clamp(2.4rem, 6vw, 4.75rem);
    font-weight: 500;
    letter-spacing: 0.005em;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__figure img {
      animation: hero-settle 1.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }

  @keyframes hero-settle {
    from { transform: scale(1.09); }
    to { transform: none; }
  }

  .hero__figure {
    max-width: 26rem;
    margin: 0;
    justify-self: center;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  /* Sits under .figure::after, so the clip picks up the same warm veil and
     colour treatment as every other photograph on the site. */
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.02);
    opacity: 0;
    transition: opacity 0.7s ease;
    pointer-events: none;
  }

  .hero__video.is-playing { opacity: 1; }

  @media (min-width: 62em) {
    .hero__inner { grid-template-columns: 1.15fr 0.85fr; }
    .hero__figure { justify-self: end; max-width: 30rem; }
  }
</style>
