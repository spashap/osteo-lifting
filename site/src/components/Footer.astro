---
import Wordmark from './Wordmark.astro';
import LangSwitcher from './LangSwitcher.astro';
import { PHONE, SOCIAL, TELEGRAM, WHATSAPP } from '../config';
import { localePath, useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  subpath?: string;
}

const { locale, subpath = '' } = Astro.props;
const t = useTranslations(locale);
const year = 2026;

const pages = [
  { label: t.nav.method, href: localePath(locale, 'method') },
  { label: t.nav.courses, href: localePath(locale, 'courses') },
  { label: t.nav.history, href: localePath(locale, 'history') },
  { label: t.nav.faq, href: `${localePath(locale)}#faq` },
];

const ariel = [
  { label: 'Telegram', href: TELEGRAM.ariel },
  { label: 'WhatsApp', href: WHATSAPP.ariel },
  { label: 'Facebook', href: SOCIAL.arielFacebook },
];

---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Wordmark locale={locale} />
      <p class="site-footer__phone">
        <a class="site-footer__phoneLink" href={`tel:${PHONE}`}>{PHONE}</a>
      </p>
      <LangSwitcher locale={locale} subpath={subpath} onDark />
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__title">{t.brand.nameShort}</h2>
      <ul class="site-footer__list">
        {
          pages.map((page) => (
            <li>
              <a href={page.href}>{page.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="site-footer__col">
      <h2 class="site-footer__title">{t.founder.nameNatural}</h2>
      <ul class="site-footer__list">
        {
          ariel.map((link) => (
            <li>
              <a href={link.href} target="_blank" rel="noopener">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

  </div>

  <div class="container site-footer__legal">
    <p>© {year} {t.brand.name}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--contrast);
    color: var(--on-contrast);
    padding-block: clamp(3rem, 6vw, 4.5rem) 1.5rem;
  }

  .site-footer__inner {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    grid-template-columns: 1fr;
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.1rem;
  }

  .site-footer__phone { margin: 0; }

  .site-footer__phoneLink {
    font-family: var(--font-display);
    font-size: var(--step-1);
    text-decoration: none;
    color: var(--on-contrast);
    font-variant-numeric: lining-nums;
    font-feature-settings: 'lnum' 1;
  }

  .site-footer__phoneLink:hover { color: var(--accent); }

  .site-footer__title {
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .site-footer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .site-footer__list a {
    font-size: 0.9rem;
    text-decoration: none;
    color: var(--on-contrast-soft);
    transition: color 160ms ease;
  }

  .site-footer__list a:hover { color: var(--on-contrast); }

  .site-footer__legal {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding-top: 1.25rem;
    border-top: 1px solid rgba(244, 239, 233, 0.14);
    font-size: 0.78rem;
    color: var(--on-contrast-soft);
  }

  @media (min-width: 40em) {
    .site-footer__inner { grid-template-columns: repeat(2, 1fr); }
    .site-footer__brand { grid-column: 1 / -1; }
  }

  @media (min-width: 62em) {
    .site-footer__inner { grid-template-columns: 1.6fr repeat(2, 1fr); }
    .site-footer__brand { grid-column: auto; }
  }
</style>
