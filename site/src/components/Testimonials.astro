---
import { Picture } from 'astro:assets';
import { img } from '../data/images';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/**
 * Several of these run to five paragraphs, which turned the section into a wall
 * of text. Long ones are clamped to a few lines behind a native `<details>`
 * disclosure — no JavaScript, and every word stays in the DOM for search
 * engines and for the `Review` structured data. Short ones render plainly, so
 * no one is asked to expand two sentences.
 */
const LONG = 340;

const items = t.testimonials.items.map((item) => {
  const [first, ...rest] = item.body;
  const length = item.body.join(' ').length;
  return { ...item, first, rest, clamp: length > LONG };
});
---

<section class="section" id="reviews">
  <div class="container">
    <div class="section-head reveal">
      <p class="eyebrow">{t.testimonials.title}</p>
      <hr class="rule" />
    </div>

    <div class="reviews">
      {
        items.map((item) => (
          <figure class="review reveal">
            <div class="review__head">
              <div class="review__avatar figure">
                <Picture
                  src={img(item.img)}
                  formats={['avif', 'webp']}
                  widths={[112, 224]}
                  sizes="72px"
                  alt={t.alt[item.img as keyof typeof t.alt]}
                  loading="lazy"
                />
              </div>
              <figcaption class="review__who">
                <span class="review__name">{item.name}</span>
                <span class="review__place">{item.place}</span>
              </figcaption>
            </div>

            {item.clamp ? (
              <details class="review__disclosure">
                <summary class="review__summary">
                  <span class="review__preview">{item.first}</span>
                  <span class="review__toggle">
                    <span class="review__toggleOpen">{t.ui.readMore}</span>
                    <span class="review__toggleClose">{t.ui.readLess}</span>
                  </span>
                </summary>
                <blockquote class="review__body review__rest">
                  {item.rest.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </blockquote>
              </details>
            ) : (
              <blockquote class="review__body">
                {item.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </blockquote>
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reviews {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    break-inside: avoid;
  }

  .review__head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .review__avatar {
    width: 4.5rem;
    height: 4.5rem;
    flex: none;
    border-radius: 999px;
  }

  .review__who {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .review__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.15;
  }

  .review__place {
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .review__body {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8em;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .review__body p { margin: 0; }

  /* --- clamped variant ------------------------------------------------ */

  .review__summary {
    display: block;
    list-style: none;
    cursor: pointer;
  }

  .review__summary::-webkit-details-marker { display: none; }

  .review__preview {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .review__disclosure[open] .review__preview {
    -webkit-line-clamp: unset;
    line-clamp: unset;
    overflow: visible;
  }

  .review__toggle {
    display: inline-block;
    margin-top: 0.8rem;
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .review__summary:hover .review__toggle { text-decoration: underline; }

  .review__toggle::after {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-left: 0.5em;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform 250ms ease;
  }

  .review__disclosure[open] .review__toggle::after {
    transform: translateY(1px) rotate(-135deg);
  }

  .review__toggleClose { display: none; }

  .review__disclosure[open] .review__toggleOpen { display: none; }
  .review__disclosure[open] .review__toggleClose { display: inline; }

  .review__rest { margin-top: 0.8em; }

  @media (min-width: 62em) {
    .reviews {
      grid-template-columns: none;
      display: block;
      columns: 2;
      column-gap: 1rem;
    }
    .review { margin-bottom: 1rem; }
  }

  @media (min-width: 82em) {
    .reviews { columns: 3; }
  }
</style>
