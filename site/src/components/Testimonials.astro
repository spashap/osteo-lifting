---
import { Picture } from 'astro:assets';
import { img } from '../data/images';
import { useTranslations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="section" id="reviews">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t.testimonials.title}</p>
      <hr class="rule" />
    </div>

    <div class="reviews">
      {
        t.testimonials.items.map((item) => (
          <figure class="review reveal">
            <div class="review__head">
              <div class="review__avatar figure">
                <Picture
                  src={img(item.img)}
                  formats={['avif', 'webp']}
                  widths={[112, 224]}
                  sizes="72px"
                  alt={t.alt[item.img as keyof typeof t.alt]}
                  loading="lazy"
                />
              </div>
              <figcaption class="review__who">
                <span class="review__name">{item.name}</span>
                <span class="review__place">{item.place}</span>
              </figcaption>
            </div>
            <blockquote class="review__body">
              {item.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </blockquote>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .reviews {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  .review {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    break-inside: avoid;
  }

  .review__head {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .review__avatar {
    width: 4.5rem;
    height: 4.5rem;
    flex: none;
    border-radius: 999px;
  }

  .review__who {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .review__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.15;
  }

  .review__place {
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .review__body {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8em;
    font-size: var(--step--1);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .review__body p { margin: 0; }

  @media (min-width: 62em) {
    .reviews {
      grid-template-columns: none;
      display: block;
      columns: 2;
      column-gap: 1rem;
    }
    .review { margin-bottom: 1rem; }
  }

  @media (min-width: 82em) {
    .reviews { columns: 3; }
  }
</style>
