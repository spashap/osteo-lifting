{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/ru/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/ru/",
      "permanent": true
    },
    {
      "source": "/history-ru",
      "destination": "/ru/history/",
      "permanent": true
    },
    {
      "source": "/history-ru/",
      "destination": "/ru/history/",
      "permanent": true
    },
    {
      "source": "/method-ru",
      "destination": "/ru/method/",
      "permanent": true
    },
    {
      "source": "/method-ru/",
      "destination": "/ru/method/",
      "permanent": true
    },
    {
      "source": "/history-ua",
      "destination": "/ua/history/",
      "permanent": true
    },
    {
      "source": "/history-ua/",
      "destination": "/ua/history/",
      "permanent": true
    },
    {
      "source": "/method-ua",
      "destination": "/ua/method/",
      "permanent": true
    },
    {
      "source": "/method-ua/",
      "destination": "/ua/method/",
      "permanent": true
    },
    {
      "source": "/history-en",
      "destination": "/en/history/",
      "permanent": true
    },
    {
      "source": "/history-en/",
      "destination": "/en/history/",
      "permanent": true
    },
    {
      "source": "/method-en",
      "destination": "/en/method/",
      "permanent": true
    },
    {
      "source": "/method-en/",
      "destination": "/en/method/",
      "permanent": true
    },
    {
      "source": "/ru/founder-and-creator",
      "destination": "/ru/",
      "permanent": true
    },
    {
      "source": "/ru/founder-and-creator/",
      "destination": "/ru/",
      "permanent": true
    },
    {
      "source": "/ru/:path((?!(?:method|history|courses)/).+)",
      "destination": "/ru/",
      "permanent": true
    },
    {
      "source": "/ua/:path((?!(?:method|history|courses)/).+)",
      "destination": "/ua/",
      "permanent": true
    },
    {
      "source": "/en/:path((?!(?:method|history|courses)/).+)",
      "destination": "/en/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
